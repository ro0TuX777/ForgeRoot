{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgeworks/schemas/artifact_index.v0_1.json",
  "title": "ForgeWorks Artifact Index",
  "type": "object",
  "required": ["schema_version", "artifacts"],
  "properties": {
    "schema_version": {"type": "string", "enum": ["0.1"]},
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["artifact_id", "path", "kind"],
        "properties": {
          "artifact_id": {"type": "string"},
          "path": {"type": "string"},
          "kind": {"type": "string"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
