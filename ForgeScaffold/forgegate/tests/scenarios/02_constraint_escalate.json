{
  "name": "constraint escalate",
  "intent": {
    "intent_id": "demo",
    "intent_version": "1",
    "constraints": [
      {"id": "c_escalate", "when": {"op": "eq", "left": {"var": "signals.policy"}, "right": "blocked"}, "effect": "escalate"}
    ],
    "escalation": {"channels": ["security"], "required_payload_fields": ["ticket"]}
  },
  "proposed_action": {
    "schema_version": "0.1",
    "action_id": "write",
    "actor_id": "agent-2",
    "params": {"path": "src/app.py"}
  },
  "signals": {"schema_version": "0.1", "values": {"policy": "blocked"}},
  "expected": {
    "decision": "ESCALATE",
    "must_include": ["escalation.channels", "reasons.triggered_rules"]
  }
}
