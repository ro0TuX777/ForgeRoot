#!/usr/bin/env bash
# scripts/warmup-local-models [model_name]

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/setup_env.sh"

MODEL="${1:-$OLLAMA_WARMUP_MODEL}"
PROMPT="${OLLAMA_WARMUP_PROMPT:-warmup}"
ENDPOINT="${OLLAMA_ENDPOINT:-http://localhost:11434}"
TIMEOUT_SEC="${OLLAMA_WARMUP_TIMEOUT_SEC:-1200}"
NUM_CTX="${OLLAMA_NUM_CTX:-8192}"
NUM_PREDICT="${OLLAMA_WARMUP_NUM_PREDICT:-8}"

echo "Warming local Ollama model: $MODEL"

"$FORGE_PYTHON" - "$MODEL" "$PROMPT" "$ENDPOINT" "$TIMEOUT_SEC" "$NUM_CTX" "$NUM_PREDICT" <<'PY'
import json
import sys
from urllib import error, request

model = sys.argv[1]
prompt = sys.argv[2]
endpoint = sys.argv[3]
timeout = float(sys.argv[4])
num_ctx = int(sys.argv[5])
num_predict = int(sys.argv[6])
url = endpoint.rstrip("/") + "/api/generate"
payload = {
    "model": model,
    "prompt": prompt,
    "stream": False,
    "options": {
        "temperature": 0.0,
        "num_ctx": max(1024, num_ctx),
        "num_predict": max(1, num_predict),
    },
}
req = request.Request(
    url=url,
    data=json.dumps(payload).encode("utf-8"),
    method="POST",
    headers={"Content-Type": "application/json"},
)
try:
    with request.urlopen(req, timeout=timeout) as resp:
        raw = resp.read().decode("utf-8")
    data = json.loads(raw) if raw else {}
except (error.HTTPError, OSError, json.JSONDecodeError) as exc:
    print(f"Warmup failed for {model}: {exc}")
    sys.exit(1)

used = (data.get("_meta") or {}).get("model_used", model)
print(f"Warmup complete: {used}")
PY
